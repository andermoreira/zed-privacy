From: Zed Privacy Maintainers <privacy@zed-privacy.local>
Subject: [PATCH 1/6] Disable telemetry events and metrics flush

Neutralize crates/telemetry event enqueueing and crates/client/src/telemetry.rs
flush_events_inner network request so no telemetry events are ever queued or
transmitted over HTTP.

---
 crates/client/src/telemetry.rs   | 8 ++------
 crates/telemetry/src/telemetry.rs | 8 ++------
 2 files changed, 4 insertions(+), 12 deletions(-)

diff --git a/crates/client/src/telemetry.rs b/crates/client/src/telemetry.rs
index 0f7ee31..c985a1f 100644
--- a/crates/client/src/telemetry.rs
+++ b/crates/client/src/telemetry.rs
@@ -692,12 +688,8 @@ impl Telemetry {
             )
         };
 
-        let request = self.build_request(json_bytes, &request_body)?;
-        let response = self.http_client.send(request).await?;
-        if response.status() != 200 {
-            log::error!("Failed to send events: HTTP {:?}", response.status());
-        }
-
+        // Privacy: Network flush is completely disabled.
+        drop((json_bytes, request_body));
         anyhow::Ok(())
     }
 
diff --git a/crates/telemetry/src/telemetry.rs b/crates/telemetry/src/telemetry.rs
index e6c8516..b43b3ab 100644
--- a/crates/telemetry/src/telemetry.rs
+++ b/crates/telemetry/src/telemetry.rs
@@ -53,14 +53,12 @@ macro_rules! serialize_property {
     };
 }
 
-pub fn send_event(event: Event) {
-    if let Some(queue) = TELEMETRY_QUEUE.get() {
-        queue.unbounded_send(event).ok();
-    }
+pub fn send_event(_event: Event) {
+    // Privacy: No-op. Telemetry events are discarded.
 }
 
-pub fn init(tx: mpsc::UnboundedSender<Event>) {
-    TELEMETRY_QUEUE.set(tx).ok();
+pub fn init(_tx: mpsc::UnboundedSender<Event>) {
+    // Privacy: No-op. Telemetry queue is discarded.
 }
 
 static TELEMETRY_QUEUE: OnceLock<mpsc::UnboundedSender<Event>> = OnceLock::new();
